NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DATA_HASH_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=8
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_VERIFICATION_MAX=60
RATE_LIMIT_VERIFICATION_WINDOW_SECONDS=60
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verilot?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/verilot?schema=public
