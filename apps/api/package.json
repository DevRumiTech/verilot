{
  "name": "@verilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace @verilot/contracts",
    "build": "tsc --build",
    "predev": "npm run build --workspace @verilot/contracts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "pretest": "npm run build --workspace @verilot/contracts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "pretypecheck": "npm run build --workspace @verilot/contracts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@verilot/contracts": "0.1.0",
    "compression": "1.8.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
