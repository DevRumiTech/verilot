{
  "name": "@verilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace @verilot/contracts && npm run db:generate",
    "build": "tsc --build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "tsx prisma/assert-local-database.ts && prisma migrate reset --force && prisma db seed",
    "db:seed": "prisma db seed",
    "predev": "npm run build --workspace @verilot/contracts && npm run db:generate",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "pretest": "npm run build --workspace @verilot/contracts && npm run db:generate",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "pretypecheck": "npm run build --workspace @verilot/contracts && npm run db:generate",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@verilot/contracts": "0.1.0",
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cookie": "2.0.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.5",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
