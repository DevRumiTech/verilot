{
  "name": "@verilot/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build && vite build",
    "dev": "vite",
    "pretest:e2e": "npm run test:e2e:prepare",
    "pretest:e2e:prepare": "npm run build --workspace @verilot/api",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:prepare": "tsx tests/e2e/prepare-database.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@verilot/contracts": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "tsx": "4.23.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
