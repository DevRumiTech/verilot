{
  "name": "verilot",
  "version": "0.1.0",
  "private": true,
  "description": "Product traceability, verification, anomaly, and recall platform.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @verilot/api",
    "db:migrate": "npm run db:migrate --workspace @verilot/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @verilot/api",
    "db:reset": "npm run db:reset --workspace @verilot/api",
    "db:seed": "npm run db:seed --workspace @verilot/api",
    "dev": "npm run dev:server",
    "dev:server": "npm run dev --workspace @verilot/api",
    "dev:web": "npm run dev --workspace @verilot/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @verilot/api",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  }
}
