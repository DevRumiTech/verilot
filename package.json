{
  "name": "verilot",
  "version": "0.1.0",
  "private": true,
  "description": "Product traceability, verification, anomaly, and recall platform.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
